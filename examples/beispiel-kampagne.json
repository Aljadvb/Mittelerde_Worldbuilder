      "events": [
        {
          "id": "evt_dorf_ankunft",
          "steps": [
            {
              "type": "text",
              "text": "Ein Hahn kräht viel zu spät am Tag. Irgendwo knarrt eine Tür. Sprecht mit den Leuten oder seht euch um."
            }
          ]
        },
        {
          "id": "evt_dorfbewohnerin",
          "steps": [
            {
              "type": "text",
              "text": "„Ihr seid wegen der Mühle hier, nicht wahr?“, flüstert die Wäscherin und blickt sich ängstlich um."
            },
            {
              "type": "choice",
              "text": "Was tut ihr?",
              "options": [
                {
                  "label": "Nach dem Müller fragen",
                  "event": "evt_frage_mueller"
                },
                {
                  "label": "Ihr beim Tragen helfen",
                  "event": "evt_waesche_tragen"
                }
              ]
            }
          ]
        },
        {
          "id": "evt_frage_mueller",
          "steps": [
            {
              "type": "text",
              "text": "„Man hat ihn fortgeschleift, in der Nacht. Ich habe die Spuren am Weg gesehen, aber ich traue mich nicht hin.“"
            },
            {
              "type": "addToken",
              "token": "tok_spuren"
            }
          ]
        },
        {
          "id": "evt_waesche_tragen",
          "steps": [
            {
              "type": "text",
              "text": "Dankbar lächelt sie. Unterwegs erzählt sie von Schleifspuren am Weg und davon, dass der Nebel jeden Abend dichter wird."
            },
            {
              "type": "changeThreat",
              "amount": -1
            },
            {
              "type": "addToken",
              "token": "tok_spuren"
            }
          ]
        },
        {
          "id": "evt_brunnen",
          "steps": [
            {
              "type": "text",
              "text": "Der Eimer hängt an einem morschen Seil. Wer das Glitzern bergen will, muss sich weit hinabbeugen."
            },
            {
              "type": "test",
              "text": "Beugt euch hinab und greift danach.",
              "attribute": "agility",
              "successes": 2,
              "onSuccess": "evt_brunnen_erfolg",
              "onFailure": "evt_brunnen_fehlschlag"
            }
          ]
        },
        {
          "id": "evt_brunnen_erfolg",
          "steps": [
            {
              "type": "text",
              "text": "Ihr bekommt einen kleinen Messingschlüssel zu fassen, in den ein Mühlrad graviert ist. Ihr fühlt euch zuversichtlicher."
            },
            {
              "type": "changeThreat",
              "amount": -2
            }
          ]
        },
        {
          "id": "evt_brunnen_fehlschlag",
          "steps": [
            {
              "type": "text",
              "text": "Das Seil reißt, der Eimer platscht in die Tiefe. Das Echo hallt unheimlich lange nach."
            },
            {
              "type": "changeThreat",
              "amount": 1
            }
          ]
        },
        {
          "id": "evt_spuren",
          "steps": [
            {
              "type": "text",
              "text": "Ihr folgt den Spuren den Hang hinab. Das Rauschen des Baches wird lauter, der Nebel dichter."
            },
            {
              "type": "unlockChapter",
              "chapter": "ch_muehle"
            },
            {
              "type": "setObjective",
              "objective": "obj_mueller_befreien"
            }
          ]
        },
        {
          "id": "evt_muehle_ankunft",
          "steps": [
            {
              "type": "text",
              "text": "Aus dem Nebel lösen sich graue Gestalten mit glühenden Augen. Knurrend versperren sie euch den Weg."
