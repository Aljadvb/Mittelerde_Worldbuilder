{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aljadvb/Mittelerde_Worldbuilder/schema/material.schema.json",
  "title": "Material-Katalog",
  "description": "Katalog des physisch vorhandenen Spielmaterials (Kacheln, Schlachtpläne, Geländeteile, Gegnertypen, Erweiterungen). Wird vom Nutzer selbst gepflegt; Kampagnen verweisen per ID darauf.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "hexOrientation": {
      "description": "Nur für die Darstellung: 'flat' = flache Seite oben (wie die Original-Kacheln), 'pointy' = Spitze oben.",
      "enum": [
        "flat",
        "pointy"
      ],
      "default": "flat"
    },
    "hexSizeMm": {
      "description": "Größe eines Felds der echten Kacheln: Mitte bis Ecke in Millimetern (Original-Kacheln: 22,2).",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 22.2
    },
    "expansions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expansion"
      }
    },
    "tiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tile"
      }
    },
    "enemyTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enemyType"
      }
    },
    "battleBoards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/battleBoard"
      }
    },
    "terrainPieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/terrainPiece"
      }
    },
    "campaignMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "description": "Optional: eigenes Kartenbild für die Kampagnenkarte (nur im privaten Katalog). Orte liegen relativ (0–1) darauf.",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Gegenstände, die Helden im Abenteuer finden können (vorerst Schmuckstücke).",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "heroes": {
      "type": "array",
      "description": "Spielbare Helden zur Auswahl beim Start einer Kampagne.",
      "items": {
        "$ref": "#/$defs/hero"
      }
    },
    "roles": {
      "type": "array",
      "description": "Rollen, die Helden einnehmen können.",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "titleFont": {
      "type": "string",
      "minLength": 1,
      "description": "Optional: eigene Schriftdatei (TTF/OTF) für Titel und Knöpfe der App, relativ zum Katalog, z. B. schrift/titel.ttf. Nur im privaten Katalog."
    },
    "ornamentFont": {
      "type": "string",
      "minLength": 1,
      "description": "Optional: Bilderschrift für Verzierungen (Ringe a–r, Schriftbänder s–v, Schwerter w/x), relativ zum Katalog. Nur im privaten Katalog."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "hex": {
      "description": "Sechseckfeld in axialen Koordinaten.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "r"
      ],
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        }
      }
    },
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owned": {
          "type": "boolean",
          "default": true,
          "description": "false = Erweiterung nicht im Besitz; Szenarien damit erzeugen eine Warnung."
        }
      }
    },
    "tileSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "description": "Felder der Kachelseite in kachel-lokalen axialen Koordinaten, von oben gesehen. (0,0) ist der Ankerpunkt und muss enthalten sein.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hex"
          }
        },
        "image": {
          "description": "Optionales Bild dieser Seite (z. B. eigener Scan), ungedreht. anchorX/anchorY = Pixelmitte des Ankerfelds (0,0), hexSize = Radius eines Felds (Mitte bis Ecke) in Pixeln.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "anchorX",
            "anchorY",
            "hexSize"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Pfad relativ zur Katalogdatei, z. B. bilder/101A.jpg"
            },
            "anchorX": {
              "type": "number"
            },
            "anchorY": {
              "type": "number"
            },
            "hexSize": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "terrain": {
          "description": "Was die Seite zeigt (feste Liste), z. B. zum Auswählen passender Kacheln für eine Geschichte.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "wiese",
              "gebuesch",
              "lichtung",
              "wald_licht",
              "wald_dicht",
              "huegel",
              "felsen",
              "gebirge",
              "oedland",
              "weg",
              "fluss",
              "gewaesser",
              "sumpf",
              "ruinen",
              "bauwerk",
              "siedlung",
              "hoehle",
              "innenraum",
              "duester"
            ]
          }
        },
        "description": {
          "description": "Kurze Beschreibung der Landschaft in eigenen Worten.",
          "type": "string"
        },
        "darkness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          },
          "description": "Felder mit aufgedrucktem Dunkelheitssymbol."
        },
        "fortified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          },
          "description": "Felder mit aufgedrucktem Symbol für Befestigt."
        },
        "rough": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          },
          "description": "Felder mit aufgedrucktem Symbol für unwegsamen Untergrund."
        },
        "walled": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          },
          "description": "Unterirdische Felder mit schwarzem Außenrand: geschlossen außer an den Durchgängen."
        },
        "passages": {
          "type": "array",
          "description": "Durchgänge (mit Pfeilen markiert) am Außenrand der unterirdischen Felder.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "q",
              "r",
              "side"
            ],
            "properties": {
              "q": {
                "type": "integer"
              },
              "r": {
                "type": "integer"
              },
              "side": {
                "enum": [
                  "N",
                  "NE",
                  "SE",
                  "S",
                  "SW",
                  "NW"
                ]
              }
            }
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "expansion",
        "sides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Aufgedruckte Kachelnummer."
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "sides": {
          "description": "Form je Seite. Beim Umdrehen wird eine Kachel gespiegelt, daher hat jede Seite eine eigene Feldliste.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "A": {
              "$ref": "#/$defs/tileSide"
            },
            "B": {
              "$ref": "#/$defs/tileSide"
            }
          }
        }
      }
    },
    "enemyType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "expansion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Gesundheit eines Gegners."
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Rüstung: fängt pro Angriff so viele Treffer ab (Durchbohren ignoriert sie)."
        },
        "sorcery": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Schutzzauber: fängt pro Angriff Treffer ab (Zerschlagen ignoriert sie)."
        },
        "movement": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "ranged": {
          "type": "boolean",
          "default": false
        },
        "attacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "damage": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "fear": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "text": {
                "type": "string",
                "description": "Kurze Beschreibung in eigenen Worten."
              },
              "negate": {
                "type": "string",
                "enum": [
                  "might",
                  "agility",
                  "wisdom",
                  "spirit",
                  "wit"
                ],
                "description": "Eigenschaft der Probe, mit der der angegriffene Held den Angriff abwehren kann: jeder Erfolg verhindert 1 Schaden oder 1 Furcht. Fehlt das Feld, ist der Angriff nicht abwehrbar (selten)."
              },
              "condition": {
                "type": "string",
                "enum": [
                  "hidden",
                  "inspired",
                  "determined",
                  "captured",
                  "disheartened",
                  "frightened"
                ],
                "description": "Zustand, den der angegriffene Held zusätzlich erhält (z. B. frightened), außer der ganze Angriff wird abgewehrt."
              }
            }
          }
        }
      }
    },
    "square": {
      "description": "Quadrat auf dem Raster eines Schlachtplans (x nach rechts, y nach unten).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "boardSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Breite in Quadraten."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Höhe in Quadraten."
        },
        "cellSizeMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 95,
          "description": "Kantenlänge eines Quadrats in Millimetern."
        },
        "areas": {
          "description": "Die aufgedruckten Felder: je eine Liste der Quadrate, die zusammen ein Feld bilden. Jedes Quadrat gehört zu genau einem Feld. Leer = jedes Quadrat ist ein eigenes Feld.",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/square"
            }
          }
        },
        "image": {
          "description": "Optionales Bild der Seite, ungedreht. originX/originY = Pixelposition der linken oberen Ecke von Quadrat (0,0), cellSize = Kantenlänge eines Quadrats in Pixeln.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "cellSize"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "originX": {
              "type": "number",
              "default": 0
            },
            "originY": {
              "type": "number",
              "default": 0
            },
            "cellSize": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "terrain": {
          "description": "Was die Seite zeigt (feste Liste), z. B. zum Auswählen passender Kacheln für eine Geschichte.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "wiese",
              "gebuesch",
              "lichtung",
              "wald_licht",
              "wald_dicht",
              "huegel",
              "felsen",
              "gebirge",
              "oedland",
              "weg",
              "fluss",
              "gewaesser",
              "sumpf",
              "ruinen",
              "bauwerk",
              "siedlung",
              "hoehle",
              "innenraum",
              "duester"
            ]
          }
        },
        "description": {
          "type": "string",
          "description": "Kurze Beschreibung in eigenen Worten."
        }
      }
    },
    "battleBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "expansion",
        "sides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Name für die Spieler, z. B. S1."
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Anzahl gleicher Exemplare im Besitz."
        },
        "sides": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "A": {
              "$ref": "#/$defs/boardSide"
            },
            "B": {
              "$ref": "#/$defs/boardSide"
            }
          }
        }
      }
    },
    "terrainPieceSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "placement"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "enum": [
            "area",
            "edge"
          ],
          "description": "area = liegt in einem Feld, edge = liegt auf einer Feldgrenze."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "widthMm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Echte Breite des Teils (waagerechte Bildseite) in Millimetern. Kantenteile: Bild verläuft entlang der Kante."
            }
          }
        },
        "terrain": {
          "description": "Was die Seite zeigt (feste Liste), z. B. zum Auswählen passender Kacheln für eine Geschichte.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "wiese",
              "gebuesch",
              "lichtung",
              "wald_licht",
              "wald_dicht",
              "huegel",
              "felsen",
              "gebirge",
              "oedland",
              "weg",
              "fluss",
              "gewaesser",
              "sumpf",
              "ruinen",
              "bauwerk",
              "siedlung",
              "hoehle",
              "innenraum",
              "duester"
            ]
          }
        },
        "effect": {
          "type": "string",
          "description": "Kurze Zusammenfassung der Wirkung in eigenen Worten (für Editor und KI)."
        },
        "cardText": {
          "type": "string",
          "description": "Text der eigenen Geländekarte. Nur im privaten Katalog, nie im Repo."
        },
        "blocksMovement": {
          "type": "boolean",
          "default": false,
          "description": "Kante: nicht überquerbar; Feld: nicht betretbar. Nur für Hinweise zur Erreichbarkeit."
        }
      }
    },
    "terrainPiece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expansion",
        "sides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Anzahl Pappteile (beide Seiten zusammen)."
        },
        "sides": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "A": {
              "$ref": "#/$defs/terrainPieceSide"
            },
            "B": {
              "$ref": "#/$defs/terrainPieceSide"
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "expansion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "trinket"
          ],
          "default": "trinket",
          "description": "trinket = Schmuckstück"
        },
        "effect": {
          "type": "string",
          "description": "Kurze Wirkung in eigenen Worten (für Editor und KI)."
        },
        "cardText": {
          "type": "string",
          "description": "Eigene Abschrift der Karte – nur im privaten Katalog."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "line": {
          "$ref": "#/$defs/id",
          "description": "Upgrade-Linie: Karten mit demselben Bild sind Stufen desselben Gegenstands."
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1,
          "description": "Stufe (römische Ziffer)."
        },
        "lore": {
          "type": "integer",
          "minimum": 0,
          "description": "Wissenswert der Karte: so viel Wissen braucht die Gruppe, um sie auf die nächste Stufe aufzuwerten."
        },
        "uses": {
          "type": "integer",
          "minimum": 0,
          "description": "Verbrauchsmarker beim Ausrüsten."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Anzahl der Karten im Spiel (z. B. zweimal Extrarationen)."
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "expansion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "folk": {
          "type": "string",
          "description": "Volk, z. B. Mensch, Hobbit, Zwerg, Elb."
        },
        "description": {
          "type": "string",
          "description": "Kurze Beschreibung in eigenen Worten."
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "expansion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expansion": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
