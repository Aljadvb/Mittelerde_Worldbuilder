{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aljadvb/Mittelerde_Worldbuilder/schema/campaign.schema.json",
  "title": "Kampagne",
  "description": "Kampagnenformat v1. Hierarchie: Kampagne → Szenarien → Kapitel → Kachel-Platzierungen/Token; dazu Events, Trigger, Ziele, Gegnergruppen, Auflösungen je Szenario. Alle Verweise laufen über IDs, die innerhalb der Kampagne eindeutig sind. Strukturelle Regeln prüft dieses Schema; Verweise, Erreichbarkeit und Katalogbezug prüft der Validator der App. Alle Texte sind eigene Texte (keine Übernahme aus geschützten Werken).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "title",
    "startScenario",
    "scenarios"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "startScenario": {
      "$ref": "#/$defs/id",
      "description": "ID des ersten Szenarios."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      },
      "description": "Verzweigungen: Endet Szenario 'from' mit Auflösung 'resolution', folgt Szenario 'to'. Auflösungen ohne Übergang beenden die Kampagne."
    },
    "places": {
      "type": "array",
      "description": "Orte auf der Kampagnenkarte.",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "flags": {
      "type": "array",
      "description": "Kampagnen-Merker, die Ergebnisse über Szenarien hinweg festhalten.",
      "items": {
        "$ref": "#/$defs/flag"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Sprechende ID, Kleinbuchstaben/Ziffern/Unterstrich, mit Typ-Präfix: cmp_, scn_, ch_, pl_, tok_, evt_, trg_, obj_, eg_, res_."
    },
    "hex": {
      "description": "Sechseckfeld in axialen Koordinaten.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "r"
      ],
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        }
      }
    },
    "tileLocation": {
      "description": "Ort auf einer platzierten Kachel.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "cell"
      ],
      "properties": {
        "placement": {
          "$ref": "#/$defs/id",
          "description": "ID einer Kachel-Platzierung (pl_…) in diesem Szenario."
        },
        "cell": {
          "$ref": "#/$defs/hex",
          "description": "Feld in kachel-lokalen Koordinaten; muss zur Form der Kachelseite gehören."
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "resolution",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "resolution": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "requiresFlag": {
          "$ref": "#/$defs/id",
          "description": "Nur, wenn dieser Kampagnen-Merker gesetzt ist; solche Übergänge haben Vorrang."
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "intro",
        "threat",
        "startChapter",
        "startObjective",
        "chapters",
        "resolutions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "description": "Einleitungstext, wird vor dem Aufbau vorgelesen."
        },
        "threat": {
          "$ref": "#/$defs/threat"
        },
        "startChapter": {
          "$ref": "#/$defs/id",
          "description": "Kapitel, das zu Spielbeginn freigeschaltet ist."
        },
        "startObjective": {
          "$ref": "#/$defs/id",
          "description": "Ziel, das zu Spielbeginn aktiv ist."
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "enemyGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enemyGroup"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resolution"
          }
        },
        "place": {
          "$ref": "#/$defs/id",
          "description": "Ort auf der Kampagnenkarte (pt_…)."
        },
        "shadowEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Events, aus denen die App am Ende jeder Runde eines zieht (auch harmlose)."
        }
      }
    },
    "threat": {
      "description": "Bedrohungsleiste. Schwellen werden als Trigger vom Typ 'threatReached' definiert.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Erreicht die Bedrohung diesen Wert, feuern Trigger vom Typ 'threatMax'."
        },
        "perRound": {
          "description": "Am Rundenende steigt die Bedrohung um base + perHero × Heldenzahl.",
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "base": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "perHero": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        }
      }
    },
    "chapter": {
      "description": "Abschnitt des Szenarios; bringt beim Freischalten eigene Kacheln (Reise) oder einen Schlachtplan (Schlacht) und Token mit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "setupText": {
          "type": "string",
          "description": "Text beim Freischalten/Aufbau des Kapitels."
        },
        "onUnlock": {
          "$ref": "#/$defs/id",
          "description": "Optional: Event, das nach dem Aufbau läuft."
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tilePlacement"
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "battlefield": {
          "$ref": "#/$defs/battlefield"
        },
        "clearBattlefield": {
          "type": "boolean",
          "default": false,
          "description": "Schlacht-Kapitel: vorher alle bisherigen Schlachtpläne und Geländeteile abräumen; sie dürfen neu gelegt werden."
        }
      }
    },
    "tilePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tile",
        "side",
        "position"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tile": {
          "$ref": "#/$defs/id",
          "description": "Kachel-ID aus dem Material-Katalog."
        },
        "side": {
          "enum": [
            "A",
            "B"
          ]
        },
        "position": {
          "$ref": "#/$defs/hex",
          "description": "Kartenkoordinate des Kachel-Ankers (lokal 0,0)."
        },
        "rotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 0,
          "description": "Drehung in 60°-Schritten im Uhrzeigersinn um den Anker."
        },
        "unexplored": {
          "type": "boolean",
          "default": false,
          "description": "Kachel liegt zunächst ausgegraut mit Erkundungsmarker; ihre Token erscheinen erst beim Erkunden. Der erkundende oder ein naher Held erhält 1 Inspiration."
        },
        "onExplore": {
          "$ref": "#/$defs/id",
          "description": "Optional: Event, das beim Erkunden läuft."
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "location"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "search",
            "person",
            "threat",
            "explore",
            "custom"
          ]
        },
        "customType": {
          "type": "string",
          "minLength": 1,
          "description": "Nur und genau bei type 'custom': Bezeichnung des eigenen Token-Typs."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "initiallyActive": {
          "type": "boolean",
          "default": true,
          "description": "false = erscheint erst durch einen Schritt 'addToken'."
        },
        "inspectText": {
          "type": "string",
          "description": "Text beim Untersuchen."
        },
        "onInteract": {
          "$ref": "#/$defs/id",
          "description": "Event, das beim Antippen läuft."
        },
        "removeAfterInteract": {
          "type": "boolean",
          "default": false
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "customType"
        ]
      },
      "else": {
        "not": {
          "required": [
            "customType"
          ]
        }
      }
    },
    "enemyGroup": {
      "description": "Gegnergruppe; erscheint durch einen Schritt 'spawnEnemies'.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enemyType",
        "count",
        "location"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "enemyType": {
          "$ref": "#/$defs/id",
          "description": "Gegnertyp-ID aus dem Material-Katalog."
        },
        "count": {
          "description": "Anzahl Gegner je Heldenzahl 1–5.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "3",
            "4",
            "5"
          ],
          "properties": {
            "1": {
              "type": "integer",
              "minimum": 0
            },
            "2": {
              "type": "integer",
              "minimum": 0
            },
            "3": {
              "type": "integer",
              "minimum": 0
            },
            "4": {
              "type": "integer",
              "minimum": 0
            },
            "5": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Schritte in Reihenfolge. 'choice', 'test' und 'endScenario' dürfen nur als letzter Schritt stehen."
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "description": "Text anzeigen.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Auswahl; jede Option führt in ein Event. Nur als letzter Schritt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "options"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "event"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "event": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "description": "Probe am Tisch; die App fragt die Anzahl der Erfolge ab. Nur als letzter Schritt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attribute",
            "successes",
            "onSuccess"
          ],
          "properties": {
            "type": {
              "const": "test"
            },
            "text": {
              "type": "string"
            },
            "attribute": {
              "enum": [
                "might",
                "agility",
                "wisdom",
                "spirit",
                "wit"
              ]
            },
            "successes": {
              "type": "integer",
              "minimum": 1
            },
            "onSuccess": {
              "$ref": "#/$defs/id"
            },
            "onFailure": {
              "$ref": "#/$defs/id",
              "description": "Optional; ohne Angabe passiert bei Misserfolg nichts weiter."
            },
            "hidden": {
              "type": "boolean",
              "default": false,
              "description": "Verdeckte Probe: Die App nennt die benötigten Erfolge nicht und meldet nur geschafft / nicht geschafft."
            },
            "cumulative": {
              "type": "boolean",
              "default": false,
              "description": "Sammelprobe: Erfolge mehrerer Versuche (je eine Aktion, auch verschiedener Helden, über Runden hinweg) werden addiert; erst bei Erreichen läuft onSuccess. Scheitert nie, onFailure entfällt. Der Marker muss liegen bleiben."
            },
            "onAttempt": {
              "$ref": "#/$defs/id",
              "description": "Nur Sammelprobe: Event nach einem Versuch, der noch nicht reicht (optional)."
            }
          }
        },
        {
          "description": "Gegnergruppe aufstellen.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "group"
          ],
          "properties": {
            "type": {
              "const": "spawnEnemies"
            },
            "group": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Bedrohung um amount ändern (negativ = senken).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "changeThreat"
            },
            "amount": {
              "type": "integer",
              "not": {
                "const": 0
              }
            }
          }
        },
        {
          "description": "Token aktivieren (muss in einem Kapitel definiert sein).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "token"
          ],
          "properties": {
            "type": {
              "const": "addToken"
            },
            "token": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Token entfernen.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "token"
          ],
          "properties": {
            "type": {
              "const": "removeToken"
            },
            "token": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Kapitel freischalten; Aufbau wird angezeigt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "chapter"
          ],
          "properties": {
            "type": {
              "const": "unlockChapter"
            },
            "chapter": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Ziel aktivieren.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "objective"
          ],
          "properties": {
            "type": {
              "const": "setObjective"
            },
            "objective": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Trigger vom Typ 'manual' auslösen.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trigger"
          ],
          "properties": {
            "type": {
              "const": "fireTrigger"
            },
            "trigger": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Belohnung: Helden erhalten Inspiration (Marker am Tisch; die App zählt nicht mit).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "gainInspiration"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 1
            },
            "who": {
              "enum": [
                "active",
                "each",
                "chosen"
              ],
              "default": "active",
              "description": "active = der handelnde Held, each = jeder Held, chosen = ein Held nach Wahl"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Belohnung: Die Gruppe findet einen Gegenstand (Schmuckstück). Ohne 'item' wählt die App ein zufälliges Schmuckstück, das die Gruppe noch nicht besitzt. Die App führt das Gruppeninventar.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "gainItem"
            },
            "item": {
              "$ref": "#/$defs/id",
              "description": "Gegenstands-ID aus dem Material-Katalog; weglassen = zufälliges Schmuckstück."
            },
            "who": {
              "enum": [
                "active",
                "each",
                "chosen"
              ],
              "default": "active",
              "description": "Wer die Karte nimmt: active = der handelnde Held, chosen = ein Held nach Wahl."
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Belohnung: Helden legen Schaden- und/oder Furchtkarten ab (die App zählt nicht mit).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "recover"
            },
            "damage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            },
            "fear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            },
            "who": {
              "enum": [
                "active",
                "each",
                "chosen"
              ],
              "default": "active"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Folge: Helden erleiden Schaden und/oder Furcht (Karten am Tisch; die App zählt nicht mit).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "sufferHarm"
            },
            "damage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            },
            "fear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            },
            "who": {
              "enum": [
                "active",
                "each",
                "chosen"
              ],
              "default": "active"
            },
            "hidden": {
              "type": "boolean",
              "default": false,
              "description": "Karten verdeckt nehmen."
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Kampagnen-Merker setzen (unsichtbar für die Spieler).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "setFlag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Verzweigung nach Kampagnen-Merker. Nur als letzter Schritt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag",
            "ifSet"
          ],
          "properties": {
            "type": {
              "const": "checkFlag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "ifSet": {
              "$ref": "#/$defs/id"
            },
            "ifNotSet": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Belohnung: Das Wissen der Gruppe steigt (die App führt es über die ganze Kampagne).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "gainLore"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "Dunkelheit: In jeder Schattenphase erleiden Helden auf Dunkelheitsfeldern so viel Furcht (0 = aus).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "setDarkness"
            },
            "fear": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 1
            }
          }
        },
        {
          "description": "Szenario mit dieser Auflösung beenden. Nur als letzter Schritt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resolution"
          ],
          "properties": {
            "type": {
              "const": "endScenario"
            },
            "resolution": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "trigger": {
      "description": "Benannter Auslöser, der Events startet und/oder Ziele erfüllt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "on"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "on": {
          "$ref": "#/$defs/condition"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Events, die beim Auslösen laufen (darf leer sein, wenn der Trigger nur ein Ziel erfüllt)."
        },
        "repeatable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "description": "Token wurde angetippt/untersucht.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "token"
          ],
          "properties": {
            "type": {
              "const": "tokenInteracted"
            },
            "token": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Bedrohung erreicht/übersteigt value (Schwelle der Bedrohungsleiste).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "threatReached"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "description": "Bedrohung erreicht das Maximum des Szenarios.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "threatMax"
            }
          }
        },
        {
          "description": "Gegnergruppe als besiegt gemeldet.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "group"
          ],
          "properties": {
            "type": {
              "const": "enemyGroupDefeated"
            },
            "group": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Ziel wurde erfüllt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "objective"
          ],
          "properties": {
            "type": {
              "const": "objectiveCompleted"
            },
            "objective": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Runde Nr. round wurde beendet.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "round"
          ],
          "properties": {
            "type": {
              "const": "roundEnded"
            },
            "round": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "description": "Eine unerforschte Kachel wurde erkundet.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "placement"
          ],
          "properties": {
            "type": {
              "const": "tileExplored"
            },
            "placement": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Wird nur durch einen Schritt 'fireTrigger' ausgelöst.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "manual"
            }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reminder",
        "completedBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "reminder": {
          "type": "string",
          "minLength": 1
        },
        "completedBy": {
          "$ref": "#/$defs/id",
          "description": "Trigger, der das Ziel erfüllt, sofern es gerade aktiv ist."
        }
      }
    },
    "resolution": {
      "description": "Ende eines Szenarios.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "outcome"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "victory",
            "defeat",
            "neutral"
          ]
        },
        "lore": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Wissen, das die Gruppe mit diesem Ende erhält."
        },
        "xp": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Erfahrung, die jeder Held mit diesem Ende erhält."
        },
        "setFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Kampagnen-Merker, die dieses Ende setzt."
        }
      }
    },
    "square": {
      "description": "Quadrat auf dem gemeinsamen Raster der Schlachtpläne eines Szenarios (x nach rechts, y nach unten).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "squareLocation": {
      "description": "Ort auf dem Schlachtplan: das Feld, in dem das Quadrat liegt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "square"
      ],
      "properties": {
        "square": {
          "$ref": "#/$defs/square"
        }
      }
    },
    "location": {
      "description": "Reise-Kapitel: Feld einer Kachel (placement + cell). Schlacht-Kapitel: Feld des Schlachtplans (square).",
      "oneOf": [
        {
          "$ref": "#/$defs/tileLocation"
        },
        {
          "$ref": "#/$defs/squareLocation"
        }
      ]
    },
    "battlefield": {
      "description": "Nur in Schlacht-Kapiteln (dann keine Kacheln): Schlachtpläne und Geländeteile.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boardPlacement"
          }
        },
        "terrain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terrainPlacement"
          }
        }
      }
    },
    "boardPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "board",
        "side",
        "position"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "board": {
          "$ref": "#/$defs/id",
          "description": "Schlachtplan-ID aus dem Material-Katalog."
        },
        "side": {
          "enum": [
            "A",
            "B"
          ]
        },
        "position": {
          "$ref": "#/$defs/square",
          "description": "Lage in ganzen Plänen: (1,0) liegt rechts neben (0,0)."
        },
        "rotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "Drehung in 90°-Schritten im Uhrzeigersinn."
        }
      }
    },
    "edge": {
      "description": "Eine Seite eines Quadrats.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "side"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "side": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        }
      }
    },
    "terrainPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "piece",
        "side"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "piece": {
          "$ref": "#/$defs/id",
          "description": "Geländeteil-ID aus dem Material-Katalog."
        },
        "side": {
          "enum": [
            "A",
            "B"
          ]
        },
        "area": {
          "$ref": "#/$defs/square",
          "description": "Für Teile, die in einem Feld liegen: ein Quadrat des Feldes."
        },
        "edge": {
          "$ref": "#/$defs/edge",
          "description": "Für Teile auf Feldgrenzen (Fluss, Graben, Mauer, Zaun)."
        },
        "customName": {
          "type": "string",
          "minLength": 1,
          "description": "Eigener Name in diesem Szenario."
        },
        "customRule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "mode": {
              "enum": [
                "replace",
                "add"
              ],
              "default": "replace",
              "description": "replace = ersetzt die Geländekarte, add = gilt zusätzlich."
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": "Ein gelegtes Geländeteil: genau eines von 'area' (Teil liegt in einem Feld) oder 'edge' (Teil liegt auf einer Feldgrenze), passend zum Katalog."
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = linker Rand, 1 = rechter Rand der Karte."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = oberer Rand, 1 = unterer Rand."
        }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
